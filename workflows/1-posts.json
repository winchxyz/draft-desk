    {
      "id": "d65db2b3-30ef-48e7-83e6-23f799bdf917",
      "name": "format drafts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Shared: read the answer file that scripts/ask.js wrote (Extract From File puts it under .data).\nfunction answer(step) {\n  const out = $input.first().json.data;\n  if (!out) throw new Error(`${step}: answer file was empty`);\n  if (!out.ok) throw new Error(`${step}: ${out.error} ${String(out.stderr || out.stdout || out.text || '').slice(0, 400)}`);\n  return out;\n}\n\n// Shared by the Code nodes that format Telegram messages (inlined by tools/build.js).\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst BANNED = ['delve', 'leverage', 'robust', 'seamless', 'pivotal', 'foster', 'intricate', 'multifaceted',\n  'navigate', 'elevate', 'unlock', 'supercharge', 'game-changer', 'revolutionize'];\n// Cheap last line of defence: flags what the voice rules ban, so you see it before you post.\nfunction lint(t) {\n  const flags = [];\n  if (/—/.test(t)) flags.push('em-dash');\n  if (/[\\u{1F300}-\\u{1FAFF}\\u{2600}-\\u{27BF}]/u.test(t)) flags.push('emoji');\n  if (/(^|\\s)#\\w/.test(t)) flags.push('hashtag');\n  if (t.length > 280) flags.push(`${t.length} chars`);\n  for (const w of BANNED) if (new RegExp(`\\\\b${w}\\\\b`, 'i').test(t)) flags.push(w);\n  return flags;\n}\n// X web intent: opens the composer with the text filled in. You still press Post yourself.\nconst intent = (text, replyTo) =>\n  'https://x.com/intent/tweet?' + (replyTo ? `in_reply_to=${replyTo}&` : '') + 'text=' + encodeURIComponent(text);\n\n// One Telegram message per draft, so you can reply to the exact draft you posted (that is how the\n// learning loop pairs your edit with our text). Buttons open X with the draft filled in.\nconst out = answer('writer');\nconst posts = out.data.posts || [];\nconst msgs = [];\nfor (const p of posts) {\n  const drafts = (p.drafts || []).map((d) => (typeof d === 'string' ? d : d.text)).filter(Boolean);\n  drafts.forEach((text, i) => {\n    const flags = lint(text);\n    let t = `#post <b>${esc(p.label || 'post')}</b> · draft ${i + 1}/${drafts.length}`;\n    t += `\\n\\n<blockquote>${esc(text)}</blockquote>`;\n    if (flags.length) t += `\\nlint: ${esc(flags.join(', '))}`;\n    if (p.media_hint) t += `\\nmedia: ${esc(p.media_hint)}`;\n    msgs.push({ json: { text: t.slice(0, 3900), post_url: intent(text), source_url: p.source_url || 'https://x.com' } });\n  });\n}\nif (!msgs.length && out.data.skipped_reason) {\n  msgs.push({ json: { text: `#post nothing worth posting this run\\n${esc(out.data.skipped_reason)}`, post_url: 'https://x.com', source_url: 'https://x.com' } });\n}\nreturn msgs;\n"
      },
