    {
      "id": "9cc0b12e-a286-4c1d-a12d-90185b3446ac",
      "name": "gate topics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Shared: read the answer file that scripts/ask.js wrote (Extract From File puts it under .data).\nfunction answer(step) {\n  const out = $input.first().json.data;\n  if (!out) throw new Error(`${step}: answer file was empty`);\n  if (!out.ok) throw new Error(`${step}: ${out.error} ${String(out.stderr || out.stdout || out.text || '').slice(0, 400)}`);\n  return out;\n}\n\n// Keep only topics that cite at least two real URLs, one of them a post on X. Grok is told the same,\n// this is the check that it listened.\nconst out = answer('research');\nconst isX = (u) => /(^|\\/\\/|\\.)(x|twitter)\\.com\\//.test(String(u));\nconst slug = (s) => String(s).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');\nreturn (out.data.topics || [])\n  .filter((t) => t && t.slug && Array.isArray(t.urls) && t.urls.length >= 2 && t.urls.some(isX))\n  .map((t) => ({ json: { ...t, slug: slug(t.slug) } }));\n"
      },
      "position": [
        1140,
        0
      ]
    },
    {
      "id": "94d50679-e94f-4ec3-b80b-f8d3cf7f9c5f",
      "name": "dedupe topics",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "parameters": {
        "operation": "removeItemsSeenInPreviousExecutions",
        "logic": "removeItemsWithAlreadySeenKeyValues",
        "dedupeValue": "={{ $json.slug }}",
        "options": {
          "scope": "node"
        }
      },
