    {
      "id": "3fe49fce-6b72-4f27-a47e-ddedb4058b53",
      "name": "apply lessons",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Shared: read the answer file that scripts/ask.js wrote (Extract From File puts it under .data).\nfunction answer(step) {\n  const out = $input.first().json.data;\n  if (!out) throw new Error(`${step}: answer file was empty`);\n  if (!out.ok) throw new Error(`${step}: ${out.error} ${String(out.stderr || out.stdout || out.text || '').slice(0, 400)}`);\n  return out;\n}\n\n// Shared by the Code nodes that format Telegram messages (inlined by tools/build.js).\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst BANNED = ['delve', 'leverage', 'robust', 'seamless', 'pivotal', 'foster', 'intricate', 'multifaceted',\n  'navigate', 'elevate', 'unlock', 'supercharge', 'game-changer', 'revolutionize'];\n// Cheap last line of defence: flags what the voice rules ban, so you see it before you post.\nfunction lint(t) {\n  const flags = [];\n  if (/—/.test(t)) flags.push('em-dash');\n  if (/[\\u{1F300}-\\u{1FAFF}\\u{2600}-\\u{27BF}]/u.test(t)) flags.push('emoji');\n  if (/(^|\\s)#\\w/.test(t)) flags.push('hashtag');\n  if (t.length > 280) flags.push(`${t.length} chars`);\n  for (const w of BANNED) if (new RegExp(`\\\\b${w}\\\\b`, 'i').test(t)) flags.push(w);\n  return flags;\n}\n// X web intent: opens the composer with the text filled in. You still press Post yourself.\nconst intent = (text, replyTo) =>\n  'https://x.com/intent/tweet?' + (replyTo ? `in_reply_to=${replyTo}&` : '') + 'text=' + encodeURIComponent(text);\n\n// Turn the analyst's answer into lines appended to prompts/lessons.txt (every writer reads that file\n// on its next run) and a short digest for you in Telegram.\nconst out = answer('analyst');\nconst lessons = out.data.lessons || [];\nlet block = '';\nfor (const l of lessons) {\n  block += `\\nLESSON: ${l.rule}\\nBEFORE (our draft): ${l.before}\\nAFTER (owner's version): ${l.after}\\n`;\n}\nlet digest = `#learned <b>${lessons.length} new lesson${lessons.length === 1 ? '' : 's'} from your edits</b>\\n${esc(out.data.summary || '')}`;\nif (lessons.length) digest += '\\n\\n' + lessons.map((l, i) => `${i + 1}. ${esc(l.rule)}`).join('\\n');\nconst facts = out.data.proposed_facts || [];\nif (facts.length) digest += '\\n\\n<b>Add to facts.txt if true:</b>\\n' + facts.map((f) => `- ${esc(f)}`).join('\\n');\nreturn [{ json: { text: block || '\\n', digest: digest.slice(0, 3900), lessons: lessons.length } }];\n"
      },
      "position": [
