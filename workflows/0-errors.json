{
  "name": "Draft Desk - errors",
  "nodes": [
    {
      "id": "c3baffb4-0df4-4b4f-acdf-983edd7f84bc",
      "name": "On error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "parameters": {},
      "position": [
        0,
        0
      ]
    },
    {
      "id": "b43e77ea-8c5c-4f2d-9d93-bc03661c89ea",
      "name": "config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// EDIT ME: the folder you unpacked Draft Desk into (forward slashes work on Windows too)\n// and your Telegram chat id (message @userinfobot to get it).\nreturn [{ json: {\n  kit_dir: 'C:/Users/you/draft-desk',\n  chat_id: '123456789',\n} }];\n"
      },
      "position": [
        260,
        0
      ]
    },
    {
      "id": "94c1beaa-e0d5-4dba-8ab6-2cbbd1982ca0",
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('config').first().json.chat_id }}",
        "text": "=#error <b>{{ $('On error').first().json.workflow.name }}</b>\nnode: {{ $('On error').first().json.execution.lastNodeExecuted }}\n{{ String($('On error').first().json.execution.error.message || '').slice(0, 600).replace(/&/g, '&amp;').replace(/</g, '&lt;') }}",
        "additionalFields": {
          "appendAttribution": false,
          "disable_web_page_preview": true,
          "parse_mode": "HTML"
        }
      },
      "position": [
        480,
        0
      ]
    },
    {
      "id": "22ce5753-3909-4e05-a957-5c349d322644",
      "name": "Read me",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -420
      ],
      "parameters": {
        "content": "## Draft Desk: errors\nSet this as the **Error workflow** in the settings of the other four, so a failed run pings you instead of failing silently.",
        "height": 220,
        "width": 520
      }
    }
  ],
  "connections": {
    "On error": {
      "main": [
        [
          {
            "node": "config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "config": {
      "main": [
        [
          {
            "node": "Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
